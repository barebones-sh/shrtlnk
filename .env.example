# Copy to .env for local development. In production (Cloud Run), set these on the
# service instead: AUTH_SECRET (and DATABASE_URL) via Secret Manager, the rest as env vars.

# PostgreSQL connection string used by the app at runtime
DATABASE_URL="postgresql://shrtlnk:shrtlnk@localhost:5432/shrtlnk"
# Optional direct (non-pooled) connection for Prisma CLI commands, e.g. Supabase
DIRECT_URL=""

# NextAuth secret: openssl rand -base64 32
AUTH_SECRET=""
# Public base URL of the site (production: https://shrtlnk.ch)
AUTH_URL="http://localhost:3000"
# Trust the host forwarded by a reverse proxy (already set in the Docker image)
# AUTH_TRUST_HOST=true

# docker-compose only
POSTGRES_USER="shrtlnk"
POSTGRES_PASSWORD="shrtlnk"
POSTGRES_DB="shrtlnk"
APP_PORT=3000
